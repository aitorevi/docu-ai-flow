{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Folders": {
    "Inbox": "./data/inbox",
    "Archive": "./data/archive",
    "Failed": "./data/failed",
    "Output": "./data/output",
    "MaxConcurrency": 3,
    "PollSeconds": 5
  },
  "GoogleDocumentAi": {
    "ProjectId": "",
    "Location": "eu",
    "ProcessorId": ""
  },
  "Company": {
    "TaxId": "",
    "Name": ""
  },
  "Extraction": {
    "Provider": "Template",
    "ConfidenceThreshold": 0.6,
    "SupplierTrustThreshold": 3
  },
  "TemplateExtractor": {
    "MinTextLength": 50,
    "OcrFallback": {
      "Enabled": false,
      "Language": "spa",
      "TimeoutSeconds": 60
    },
    "Templates": [
      {
        "SupplierId": "aurora",
        "SupplierName": "Suministros Aurora S.L.",
        "SupplierTaxId": "B12345674",
        "IdentificationAnchors": [ "SUMINISTROS AURORA", "B12345674" ],
        "Fields": {
          "invoice_number": { "Anchors": [ "Factura Nº" ], "Pattern": ":\\s*(\\S+)" },
          "issue_date": { "Anchors": [ "Fecha" ], "Pattern": ":\\s*([\\d/]+)" },
          "due_date": { "Anchors": [ "Vencimiento" ], "Pattern": ":\\s*([\\d/]+)" },
          "net_amount": { "Anchors": [ "Base imponible" ], "Pattern": ":\\s*([\\d.,]+)" },
          "tax_amount": { "Anchors": [ "IVA 21%" ], "Pattern": ":\\s*([\\d.,]+)" },
          "total_amount": { "Anchors": [ "Total factura" ], "Pattern": ":\\s*([\\d.,]+)" }
        }
      },
      {
        "SupplierId": "boreal",
        "SupplierName": "Energía Boreal S.A.",
        "SupplierTaxId": "A87654321",
        "IdentificationAnchors": [ "ENERGIA BOREAL", "A87654321" ],
        "Fields": {
          "invoice_number": { "Anchors": [ "Documento Fecha Vencimiento" ], "Pattern": "[\\s\\S]*?\\n(\\S+)\\s" },
          "issue_date": { "Anchors": [ "Documento Fecha Vencimiento" ], "Pattern": "[\\s\\S]*?\\n\\S+\\s+(\\d{2}/\\d{2}/\\d{4})" },
          "due_date": { "Anchors": [ "Documento Fecha Vencimiento" ], "Pattern": "[\\s\\S]*?\\n\\S+\\s+\\d{2}/\\d{2}/\\d{4}\\s+(\\d{2}/\\d{2}/\\d{4})" },
          "net_amount": { "Anchors": [ "BASE IVA TOTAL" ], "Pattern": "[\\s\\S]*?\\n([\\d.,]+)\\s" },
          "tax_amount": { "Anchors": [ "BASE IVA TOTAL" ], "Pattern": "[\\s\\S]*?\\n[\\d.,]+\\s+([\\d.,]+)\\s" },
          "total_amount": { "Anchors": [ "BASE IVA TOTAL" ], "Pattern": "[\\s\\S]*?\\n[\\d.,]+\\s+[\\d.,]+\\s+([\\d.,]+)" }
        }
      },
      {
        "SupplierId": "cronos",
        "SupplierName": "Papelería Cronos S.L.U.",
        "SupplierTaxId": "B55512345",
        "IdentificationAnchors": [ "PAPELERIA CRONOS", "B55512345" ],
        "Fields": {
          "invoice_number": { "Anchors": [ "Invoice no." ], "Pattern": "[.\\s]*(\\S+)" },
          "issue_date": { "Anchors": [ "Issue date" ], "Pattern": "[.\\s]*([A-Za-z]{3}\\s+\\d{1,2},\\s+\\d{4})" },
          "net_amount": { "Anchors": [ "Net" ], "Pattern": "[.\\s]*([\\d.,]+)" },
          "tax_amount": { "Anchors": [ "VAT (21%)" ], "Pattern": "[.\\s]*([\\d.,]+)" },
          "total_amount": { "Anchors": [ "Amount due" ], "Pattern": "[.\\s]*([\\d.,]+)" }
        }
      }
    ]
  },
  "SupplierCatalog": {
    "Suppliers": [
      { "CanonicalName": "Suministros Aurora", "TaxId": "B12345674", "Aliases": [ "SUMINISTROS AURORA S.L." ] },
      { "CanonicalName": "Energía Boreal", "TaxId": "A87654321", "Aliases": [ "ENERGIA BOREAL S.A.", "Energia Boreal" ] },
      { "CanonicalName": "Papelería Cronos", "TaxId": "B55512345", "Aliases": [ "PAPELERIA CRONOS S.L.U." ] }
    ]
  },
  "Resend": {
    "ApiKey": "",
    "FromName": "Procesador de Facturas",
    "FromAddress": "facturas@tudominio.com",
    "AdvisorAddress": "asesor@gestoria.com",
    "CcAddress": "",
    "MaxAttachmentMb": 38
  },
  "MailDispatch": {
    "MaxAttachmentMb": 38
  },
  "Database": {
    "Path": "./data/invoices.db"
  }
}
