# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
# Key format: Section__Key  (double underscore = config section separator in .NET)
#
# Everything below is OPTIONAL. With no .env at all the app runs on the local
# template extractor, offline and for free.

# Extraction backend: Template (default, local, no credentials) or DocumentAi (Google, paid).
# An unrecognised value falls back to Template.
Extraction__Provider=Template

# Only for Extraction__Provider=DocumentAi.
# Credentials come from the service-account JSON pointed to by GOOGLE_APPLICATION_CREDENTIALS (ADC).
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GoogleDocumentAi__ProjectId=your-gcp-project-id
GoogleDocumentAi__Location=eu
GoogleDocumentAi__ProcessorId=your-processor-id

# Only for scanned invoices. Requires poppler + tesseract installed on the machine:
#   macOS          brew install poppler tesseract tesseract-lang
#   Debian/Ubuntu  apt-get install poppler-utils tesseract-ocr tesseract-ocr-spa
TemplateExtractor__OcrFallback__Enabled=false

# Your own company identity — filtered out of the extracted supplier fields.
Company__TaxId=
Company__Name=

# Only for emailing the quarter to your advisor.
Resend__ApiKey=re_your-key-here
Resend__FromAddress=facturas@tudominio.com
Resend__AdvisorAddress=asesor@gestoria.com
# Opcional: copia del correo al remitente
Resend__CcAddress=
